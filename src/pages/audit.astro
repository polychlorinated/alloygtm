---
import Base from "../layouts/Base.astro";
---

<Base
  title="Free GTM Signal Resonance Audit — Alloy GTM"
  description="Measure the gap between the signal your company broadcasts and the signal your market broadcasts. Free first-pass GTM Signal Resonance Report."
  active="audit"
>
  <!-- EXPLANATION -->
  <section class="field field--paper" data-thread style="--thread-w: 2px;">
    <div class="audit__grid">
      <div class="audit__copy">
        <p class="label audit__run"><span class="accent">RUN 003</span> — RESONANCE</p>
        <h1 class="display">Most consultants fix your message. We measure whether it's landing.</h1>
        <div class="audit__body">
          <p>
            Your company sends carefully crafted signals to future customers — your website, your
            content, your positioning. But there's a second signal you may be missing: your market
            is broadcasting its pain in real time — on forums, review sites, social media, and
            competitor reviews. That signal tells you exactly what buyers are looking for and what
            they're not finding.
          </p>
          <p>
            The Alloy GTM Signal Audit measures the gap between the signal you're sending and the
            one the market is broadcasting — for you and your top competitors, across the pain
            points that drive purchase decisions. The result isn't a positioning document. It's a
            resonance score and a specific map of where your competitors are leaving signal
            unclaimed.
          </p>
          <p>
            Enter your main product page below to see a first-pass Signal Resonance Report. Ready to
            go deeper? The Enhanced GTM Signal Report comes with a 30-minute debrief that turns the
            analysis into a specific, actionable brief for your next GTM move.
          </p>
          <p>
            <a class="link-secondary" href="#instrument">Skip to the instrument ↓</a>
          </p>
        </div>
      </div>

      <figure class="spectro">
        <figcaption class="spectro__title label">
          <span class="accent">FIG. 2</span>
          <span>SIGNAL INTENSITY SPECTROGRAM — SIX BANDS, ONE MARKET</span>
        </figcaption>
        <svg viewBox="0 0 560 340" role="img" aria-label="Spectrogram showing signal intensity across six market bands, with a cluster of unclaimed signal highlighted in orange">
          <!-- band labels -->
          <g font-family="DM Mono, monospace" font-size="10" letter-spacing="1" fill="#8ca0a7">
            <text x="0" y="40">POSITIONING</text>
            <text x="0" y="88">CONTENT</text>
            <text x="0" y="136">REVIEWS</text>
            <text x="0" y="184">FORUMS</text>
            <text x="0" y="232">SOCIAL</text>
            <text x="0" y="280">COMPETITOR</text>
          </g>
          <!-- intensity cells -->
          <g>
            <!-- row helper: y = 24 + row*48, height 32 -->
            <!-- POSITIONING -->
            <g fill="#4d86ff">
              <rect x="110" y="24" width="18" height="32" opacity="0.9"></rect>
              <rect x="134" y="24" width="18" height="32" opacity="0.75"></rect>
              <rect x="158" y="24" width="18" height="32" opacity="0.8"></rect>
              <rect x="182" y="24" width="18" height="32" opacity="0.55"></rect>
              <rect x="206" y="24" width="18" height="32" opacity="0.35"></rect>
              <rect x="230" y="24" width="18" height="32" opacity="0.3"></rect>
              <rect x="254" y="24" width="18" height="32" opacity="0.2"></rect>
            </g>
            <g fill="#f06432">
              <rect x="374" y="24" width="18" height="32" opacity="0.95"></rect>
              <rect x="398" y="24" width="18" height="32" opacity="0.8"></rect>
              <rect x="422" y="24" width="18" height="32" opacity="0.6"></rect>
            </g>
            <!-- CONTENT -->
            <g fill="#4d86ff">
              <rect x="110" y="72" width="18" height="32" opacity="0.6"></rect>
              <rect x="134" y="72" width="18" height="32" opacity="0.7"></rect>
              <rect x="158" y="72" width="18" height="32" opacity="0.5"></rect>
              <rect x="182" y="72" width="18" height="32" opacity="0.25"></rect>
            </g>
            <g fill="#f06432">
              <rect x="398" y="72" width="18" height="32" opacity="0.85"></rect>
              <rect x="422" y="72" width="18" height="32" opacity="0.7"></rect>
              <rect x="446" y="72" width="18" height="32" opacity="0.5"></rect>
            </g>
            <!-- REVIEWS -->
            <g fill="#4d86ff">
              <rect x="110" y="120" width="18" height="32" opacity="0.3"></rect>
              <rect x="134" y="120" width="18" height="32" opacity="0.2"></rect>
            </g>
            <g fill="#f06432">
              <rect x="350" y="120" width="18" height="32" opacity="0.7"></rect>
              <rect x="374" y="120" width="18" height="32" opacity="0.9"></rect>
              <rect x="398" y="120" width="18" height="32" opacity="0.95"></rect>
              <rect x="422" y="120" width="18" height="32" opacity="0.75"></rect>
            </g>
            <!-- FORUMS -->
            <g fill="#4d86ff">
              <rect x="110" y="168" width="18" height="32" opacity="0.15"></rect>
            </g>
            <g fill="#f06432">
              <rect x="374" y="168" width="18" height="32" opacity="0.8"></rect>
              <rect x="398" y="168" width="18" height="32" opacity="1"></rect>
              <rect x="422" y="168" width="18" height="32" opacity="0.9"></rect>
              <rect x="446" y="168" width="18" height="32" opacity="0.6"></rect>
            </g>
            <!-- SOCIAL -->
            <g fill="#4d86ff">
              <rect x="110" y="216" width="18" height="32" opacity="0.45"></rect>
              <rect x="134" y="216" width="18" height="32" opacity="0.3"></rect>
              <rect x="158" y="216" width="18" height="32" opacity="0.2"></rect>
            </g>
            <g fill="#f06432">
              <rect x="422" y="216" width="18" height="32" opacity="0.65"></rect>
              <rect x="446" y="216" width="18" height="32" opacity="0.5"></rect>
            </g>
            <!-- COMPETITOR -->
            <g fill="#4d86ff">
              <rect x="254" y="264" width="18" height="32" opacity="0.5"></rect>
              <rect x="278" y="264" width="18" height="32" opacity="0.65"></rect>
              <rect x="302" y="264" width="18" height="32" opacity="0.55"></rect>
            </g>
          </g>
          <!-- bracket marking the unclaimed region -->
          <path d="M344,16 v288" stroke="#f06432" stroke-width="1.5" stroke-dasharray="4 4"></path>
          <text x="352" y="12" font-family="DM Mono, monospace" font-size="10" letter-spacing="1" fill="#f06432">UNCLAIMED SIGNAL</text>
          <!-- axis -->
          <text x="110" y="326" font-family="DM Mono, monospace" font-size="10" letter-spacing="1.5" fill="#8ca0a7">YOUR BROADCAST →</text>
          <text x="380" y="326" font-family="DM Mono, monospace" font-size="10" letter-spacing="1.5" fill="#8ca0a7">MARKET FRICTION →</text>
        </svg>
      </figure>
    </div>
  </section>

  <!-- CONSOLE -->
  <section class="field field--ink" id="instrument" data-thread="hot" style="--thread-w: 5px;">
    <p class="label section-kicker"><span class="accent">INSTRUMENT</span></p>
    <h2 class="title section-title">Free GTM Signal Resonance Audit.</h2>
    <p class="section-lede">
      Analyze your product's broadcast intensity against real-world friction to identify signal
      gaps.
    </p>

    <form
      class="console__form"
      action="https://n8n.srv725961.hstgr.cloud/webhook/08b9c285-d0b5-4929-b57d-9f0fcfa653fa"
      method="POST"
      data-audit-form
      novalidate
    >
      <label class="label console__label" for="audit-url">Product URL</label>
      <div class="console__row">
        <input
          class="input console__input"
          id="audit-url"
          name="url"
          type="url"
          placeholder="https://yourproduct.com"
          required
        />
        <button class="button-primary" type="submit">Audit signal</button>
      </div>
      <p class="console__error label" data-audit-error role="alert" hidden>
        That URL didn't resolve as written — check the address and try again.
      </p>
    </form>

    <!-- scanning state -->
    <div class="console__scan" data-audit-scan hidden aria-live="polite">
      <p class="label console__scan-title">BROADCASTING AUDIT SIGNAL…</p>
      <ul class="console__log label" data-audit-log role="list"></ul>
    </div>

    <!-- report -->
    <div class="report" data-audit-report hidden>
      <p class="report__banner label" role="note">
        SAMPLE REPORT — SYNTHETIC VALUES. The live analysis backend is being reconnected to this
        rebuilt site; the format below is real, the numbers are not.
      </p>

      <div class="report__head">
        <div>
          <p class="label report__k">Audit subject</p>
          <p class="report__subject" data-report-subject>—</p>
        </div>
        <div>
          <p class="label report__k">Category</p>
          <p class="report__v">B2B SOFTWARE <span class="sample-tag">sample</span></p>
        </div>
        <div class="report__score">
          <p class="label report__k">Resonance score</p>
          <p class="report__pct">62<span class="report__pct-sym">%</span> <span class="sample-tag">sample</span></p>
          <div class="report__meter" aria-hidden="true"><span style="width: 62%"></span></div>
        </div>
      </div>

      <div class="report__integrity">
        <p class="label report__section-k">Signal integrity</p>
        <div class="report__row">
          <span class="label">Primary signal</span>
          <span>Automation of manual data entry <span class="sample-tag">sample</span></span>
        </div>
        <div class="report__row">
          <span class="label">Top market distortion</span>
          <span>Buyers asking for integrations you already ship <span class="sample-tag">sample</span></span>
        </div>
        <div class="report__row">
          <span class="label">Brand signal</span>
          <span class="report__bar"><span style="width: 74%"></span></span>
        </div>
        <div class="report__row">
          <span class="label">Market friction</span>
          <span class="report__bar report__bar--orange"><span style="width: 88%"></span></span>
        </div>
        <div class="report__row">
          <span class="label">Competitors tracked</span>
          <span>3 <span class="sample-tag">sample</span></span>
        </div>
      </div>

      <div class="report__locked">
        <p class="label report__section-k"><span aria-hidden="true">▣</span> Strategic signal breakdown — locked</p>
        <ul class="report__locked-list" role="list">
          <li>Preliminary analysis</li>
          <li>Strategic recommendation</li>
          <li>Overemphasized signals</li>
          <li>Opportunities to beat competitors</li>
        </ul>
        <p class="report__locked-copy">
          The Enhanced GTM Signal Report unlocks the full breakdown, with a 30-minute debrief that
          turns it into a specific brief for your next move.
        </p>
        <a class="button-primary" href="/contact/">Book the debrief</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-audit-form]");
  const scan = document.querySelector<HTMLElement>("[data-audit-scan]");
  const logList = document.querySelector<HTMLUListElement>("[data-audit-log]");
  const report = document.querySelector<HTMLElement>("[data-audit-report]");
  const error = document.querySelector<HTMLElement>("[data-audit-error]");
  const subject = document.querySelector<HTMLElement>("[data-report-subject]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const FULL_REPORT_WEBHOOK_URL =
    "https://n8n.srv725961.hstgr.cloud/webhook/08b9c285-d0b5-4929-b57d-9f0fcfa653fa";

  const LOG_LINES = [
    "RESOLVING SUBJECT…",
    "SAMPLING MARKET FRICTION — FORUMS / REVIEWS / SOCIAL…",
    "TRACKING COMPETITOR BROADCAST…",
    "COMPUTING RESONANCE…",
  ];

  form?.addEventListener("submit", (ev) => {
    ev.preventDefault();
    const input = form.querySelector<HTMLInputElement>("#audit-url");
    const value = input?.value.trim() ?? "";
    let host = "";
    try {
      host = new URL(value).hostname.replace(/^www\./, "");
    } catch {
      host = "";
    }
    if (!host) {
      if (error) error.hidden = false;
      input?.focus();
      return;
    }
    if (error) error.hidden = true;
    if (report) report.hidden = true;
    if (scan) scan.hidden = false;
    if (logList) logList.innerHTML = "";

    const payload = new FormData(form);
    payload.set("url", value);
    payload.set("host", host);
    payload.set("source", "signal-audit");
    payload.set("submittedAt", new Date().toISOString());

    fetch(FULL_REPORT_WEBHOOK_URL, {
      method: "POST",
      body: payload,
      mode: "no-cors",
      keepalive: true,
    }).catch(() => {
      // The sample report can still render if the notification webhook is unavailable.
    });

    const finish = () => {
      if (scan) scan.hidden = true;
      if (subject) subject.textContent = host;
      if (report) {
        report.hidden = false;
        report.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
      }
    };

    if (reduced) {
      finish();
      return;
    }

    LOG_LINES.forEach((line, i) => {
      setTimeout(() => {
        const li = document.createElement("li");
        li.textContent = line;
        logList?.appendChild(li);
        if (i === LOG_LINES.length - 1) setTimeout(finish, 500);
      }, i * 450);
    });
  });
</script>

<style>
  .section-kicker {
    margin: 0 0 20px;
    color: var(--mist);
  }

  .section-title {
    margin: 0 0 20px;
    max-width: 20ch;
  }

  .section-lede {
    max-width: 56ch;
    color: var(--paper-muted);
    margin: 0 0 var(--space-field);
  }

  #instrument {
    scroll-margin-top: 64px;
  }

  /* Explanation */
  .audit__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  .audit__run {
    margin: 0 0 24px;
    color: var(--ink-muted);
  }

  .audit__copy h1 {
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    max-width: 14ch;
    margin-bottom: 28px;
  }

  .audit__body {
    max-width: 62ch;
  }

  .audit__body p {
    margin: 0 0 20px;
  }

  .spectro {
    margin: 0;
    background: var(--ink);
    border: 1px solid var(--rule-dark);
    border-radius: 2px;
    padding: 16px;
    box-shadow: 10px 12px 0 rgba(7, 27, 36, 0.14);
  }

  .spectro__title {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--rule-dark);
    color: var(--paper);
  }

  .spectro__title .accent {
    white-space: nowrap;
    color: var(--reaction-orange);
  }

  /* Console */
  .console__form {
    max-width: 720px;
  }

  .console__label {
    display: block;
    color: var(--mist);
    margin-bottom: 8px;
  }

  .console__row {
    display: flex;
    gap: 12px;
  }

  .console__input {
    flex: 1;
    border-color: var(--rule-dark);
  }

  .console__error {
    color: var(--reaction-orange);
    margin: 12px 0 0;
  }

  .console__scan {
    margin-top: var(--space-field);
    border: 1px solid var(--rule-dark);
    padding: 24px;
    max-width: 720px;
  }

  .console__scan-title {
    color: var(--reagent-blue-bright);
    margin: 0 0 16px;
  }

  .console__log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--paper);
  }

  .console__log li::before {
    content: "» ";
    color: var(--reaction-orange);
  }

  /* Report */
  .report {
    margin-top: var(--space-field);
    border: 1px solid var(--rule-dark);
    background: var(--ink-raised);
    scroll-margin-top: 80px;
  }

  .report__banner {
    margin: 0;
    padding: 14px 24px;
    background: var(--reaction-orange);
    color: var(--ink);
  }

  .report__head {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 24px;
    padding: 24px;
    border-bottom: 1px solid var(--rule-dark);
  }

  .report__k {
    color: var(--mist);
    margin: 0 0 8px;
  }

  .report__subject {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    text-transform: uppercase;
    margin: 0;
    word-break: break-all;
  }

  .report__v {
    margin: 0;
  }

  .report__pct {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 3rem;
    line-height: 1;
    margin: 0 0 12px;
    color: var(--paper);
  }

  .report__pct-sym {
    font-size: 1.5rem;
    color: var(--mist);
  }

  .report__meter {
    height: 8px;
    background: var(--ink);
    border: 1px solid var(--rule-dark);
  }

  .report__meter span {
    display: block;
    height: 100%;
    background: var(--reagent-blue-bright);
  }

  .sample-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--reaction-orange-bright);
    border: 1px solid var(--reaction-orange-bright);
    padding: 1px 6px;
    margin-left: 8px;
    vertical-align: middle;
    white-space: nowrap;
  }

  .report__integrity {
    padding: 24px;
    border-bottom: 1px solid var(--rule-dark);
  }

  .report__section-k {
    color: var(--reagent-blue-bright);
    margin: 0 0 16px;
  }

  .report__row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule-dark);
    color: var(--paper-muted);
  }

  .report__row:last-child {
    border-bottom: none;
  }

  .report__row .label {
    color: var(--mist);
  }

  .report__bar {
    height: 12px;
    background: var(--ink);
    border: 1px solid var(--rule-dark);
  }

  .report__bar span {
    display: block;
    height: 100%;
    background: var(--reagent-blue-bright);
  }

  .report__bar--orange span {
    background: var(--reaction-orange);
  }

  .report__locked {
    padding: 24px;
  }

  .report__locked-list {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .report__locked-list li {
    border: 1px dashed var(--rule-dark);
    padding: 14px 16px;
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .report__locked-copy {
    color: var(--paper-muted);
    max-width: 56ch;
    margin: 0 0 24px;
  }

  @media (max-width: 1000px) {
    .audit__grid {
      grid-template-columns: 1fr;
    }
    .report__head {
      grid-template-columns: 1fr;
    }
    .report__row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .report__locked-list {
      grid-template-columns: 1fr;
    }
    .console__row {
      flex-direction: column;
    }
  }
</style>
