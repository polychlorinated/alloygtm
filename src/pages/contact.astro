---
import Base from "../layouts/Base.astro";

const faqs = [
  {
    q: "Are you a fractional CMO? RevOps consultant? Something else?",
    a: "I study your buyer journey and validate the signal you can leverage to grow. Most projects are short-term by design — 2 to 8 weeks — unlike fractional professionals. You can purchase a research report on your buyer journey, add a playbook of GTM systems and motions for your team, or hire me to build out your GTM team. Think of me as your GTM pinch hitter: I fill research or execution gaps to catalyze growth.",
  },
  {
    q: "Why does diagnosing GTM signal require someone outside the building?",
    a: "Because this work is foundational, not tactical. Your PMM, growth lead, or sales leader could attempt it, but in practice they prioritize task execution — demos, campaigns, pipeline targets. Deep signal diagnosis requires stepping back from output to question the underlying ICP, value proposition, and buyer-journey assumptions, and quarterly pressure kills its momentum. It's also difficult to objectively challenge the thesis you built: when a second product or segment underperforms, teams optimize volume rather than question signal alignment. An external audit separates assumption from evidence without internal politics — and it de-risks your next major hire or channel investment in weeks, not months.",
  },
  {
    q: "We're hiring a product marketer to solve this.",
    a: "You're on the right track if product marketing is already planned — my earliest GTM wins were shaped by taking a PMM approach to customer development. But if you hire a PMM before you have clear GTM signal, you may be setting them up to fail: they'll spend their first 90 days guessing, just like you are now, except you'll be paying their benefits and overhead. The signal audit ensures your first hire walks in on Day 1 executing a proven playbook — the results are their starting point, 90-day plan, and insurance all rolled into one.",
  },
];

const channels = [
  { name: "LinkedIn", url: "https://linkedin.com/in/andrewscottcampbell" },
  { name: "Instagram", url: "https://www.instagram.com/andrewcampbellofficial" },
  { name: "Facebook", url: "https://www.facebook.com/andrew.scott.campbell" },
  { name: "WhatsApp", url: "https://wa.me/12178985266" },
];
---

<Base
  title="Work With Andrew — Alloy GTM"
  description="Start a project conversation with Andrew Campbell. A 30-minute, no-prep call about where your pipeline feels stuck."
  active="contact"
>
  <!-- INTAKE -->
  <section class="field field--paper" data-thread style="--thread-w: 2px;">
    <div class="intake__grid">
      <div class="intake__copy">
        <p class="label intake__run"><span class="accent">RUN 002</span> — INTAKE</p>
        <h1 class="display">Work with Andrew.</h1>
        <div class="intake__bio">
          <p>
            I love digging into product lifecycles with founders and their teams. I thrive on the
            momentum of building world-changing things — that's why I've journeyed from the
            chemistry lab to edtech, SaaS, and AI automation, touching every stage of growth along
            the way.
          </p>
          <p>
            Product-market fit isn't a pure metal; it's an alloy. It's the compound of your
            solution, your customer's needs, and the broader ecosystem they operate in. Shift the
            product or the segment, and the entire GTM foundation shifts with it — that's where I
            come in.
          </p>
          <p>
            I sit at the intersection of messaging, data, and execution. I map your customer journey
            and GTM motions to find the signal, then work backwards into the systems and messaging
            that make the connection undeniable. I work with 2–3 companies at a time, so the
            engagement is focused and the thinking is fresh.
          </p>
        </div>
        <div class="intake__channels">
          <p class="label intake__channels-label">DIRECT CHANNELS</p>
          <ul role="list">
            {
              channels.map((c) => (
                <li>
                  <a class="link-secondary" href={c.url} target="_blank" rel="noopener noreferrer">
                    {c.name} ↗
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="intake__record">
        <p class="label intake__record-title"><span class="accent">INTAKE RECORD</span> — 30-MINUTE CALL, NO PREP NEEDED</p>
        <p class="intake__record-sub">
          Show up ready to talk about where your pipeline feels stuck. Alloy GTM reads every
          submission personally.
        </p>
        <form
          class="intake__form"
          action="https://n8n.srv725961.hstgr.cloud/webhook/76a44023-d02b-4017-95ae-75435abe772e"
          method="POST"
        >
          <div class="field-group">
            <label class="label" for="name">Name</label>
            <input class="input" id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field-group">
            <label class="label" for="company">Company</label>
            <input class="input" id="company" name="company" type="text" autocomplete="organization" required />
          </div>
          <div class="field-group">
            <label class="label" for="email">Email</label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field-group">
            <label class="label" for="stuck">Where does your pipeline feel stuck?</label>
            <textarea class="input" id="stuck" name="stuck" rows="5" required></textarea>
          </div>
          <button class="button-primary" type="submit">Request the call</button>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="field field--ink" data-thread style="--thread-w: 4px;">
    <p class="label section-kicker"><span class="accent">CLARIFICATIONS</span></p>
    <h2 class="title section-title">Frequently asked questions.</h2>
    <div class="faq">
      {
        faqs.map((f, i) => (
          <details class="faq__item">
            <summary>
              <span class="label faq__id">Q-{String(i + 1).padStart(2, "0")}</span>
              <span class="faq__q">{f.q}</span>
            </summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intake__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .intake__run {
    margin: 0 0 24px;
    color: var(--ink-muted);
  }

  .intake__copy h1 {
    margin-bottom: 28px;
  }

  .intake__bio {
    max-width: 62ch;
  }

  .intake__bio p {
    margin: 0 0 20px;
  }

  .intake__channels {
    margin-top: var(--space-field);
    border-top: 1px solid var(--rule-light);
    padding-top: 24px;
  }

  .intake__channels-label {
    color: var(--ink-muted);
    margin: 0 0 16px;
  }

  .intake__channels ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
  }

  .intake__record {
    background: var(--paper-bright);
    border: 1px solid var(--ink);
    border-radius: 2px;
    padding: var(--space-field);
    box-shadow: 12px 14px 0 rgba(7, 27, 36, 0.16);
  }

  .intake__record-title {
    margin: 0 0 12px;
    color: var(--ink-muted);
  }

  .intake__record-sub {
    margin: 0 0 28px;
    font-size: 0.9375rem;
    color: var(--ink-subtle);
    max-width: 46ch;
  }

  .intake__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-group .label {
    color: var(--ink-subtle);
  }

  /* FAQ */
  .section-kicker {
    margin: 0 0 20px;
    color: var(--mist);
  }

  .section-title {
    margin: 0 0 var(--space-field);
  }

  .faq {
    border-top: 1px solid var(--rule-dark);
    max-width: 860px;
  }

  .faq__item {
    border-bottom: 1px solid var(--rule-dark);
  }

  .faq__item summary {
    display: flex;
    gap: 24px;
    align-items: baseline;
    padding: 24px 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: "+";
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--reaction-orange);
    font-size: 1.125rem;
  }

  .faq__item[open] summary::after {
    content: "–";
  }

  .faq__id {
    color: var(--reagent-blue-bright);
    flex-shrink: 0;
  }

  .faq__q {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .faq__a {
    margin: 0;
    padding: 0 0 28px;
    color: var(--paper-muted);
    max-width: 68ch;
  }

  @media (max-width: 900px) {
    .intake__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
