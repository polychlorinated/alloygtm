---
import Base from "../layouts/Base.astro";

// TODO: replace with the production Crucible application URL (open decision in PRODUCT.md)
const CRUCIBLE_APP_URL = "https://trycrucible.com";

const steps = [
  {
    n: "01",
    name: "Onboarding",
    text: "Enter your website and answer a few questions. Crucible analyzes both to build a brand voice profile — tone, vocabulary, do-and-don't-say lists, audience, and content pillars. You review and approve it before anything gets written.",
  },
  {
    n: "02",
    name: "Capture",
    text: "Two ways in. When you know what to say, Crucible suggests topic prompts and Director Mode coaches your A-roll and B-roll. When you're stuck, step into the Podcast Studio — an AI interviewer studies your brand profile, knowledge base, and research, then asks directed questions to pull the right take out of you. Record or upload directly in the app.",
  },
  {
    n: "03",
    name: "Process",
    text: "Your footage is transcribed, then an AI editorial director re-cuts it — hook-first reordering, tangent and stutter removal, B-roll placement. Every edit is validated against runtime budgets and sentence-boundary rules, then rendered with brand cards, loudness normalization, and captions you can edit or export as .vtt or .srt.",
  },
  {
    n: "04",
    name: "Content",
    text: "Crucible writes posts in your brand voice for the platforms you actually use — Instagram, Facebook, YouTube, LinkedIn, X, TikTok — plus a full blog post, with optional AI-generated images.",
  },
  {
    n: "05",
    name: "Ship",
    text: "Review and edit everything. Not happy with the cut? Magic Revision takes your plain-language feedback and re-edits the video. Then export files or publish directly via webhook or HighLevel.",
  },
];
---

<Base
  title="Crucible — Record two minutes. Get a week of content."
  description="Crucible bridges the gap between having something to say and actually publishing it — an AI content engine built by Alloy GTM. Record two minutes, get an edited video and a week of posts."
  active="crucible"
>
  <!-- HERO -->
  <section class="field field--paper hero" data-thread style="--thread-w: 2px;">
    <p class="label hero__run"><span class="accent">CRUCIBLE</span> — AN ALLOY GTM PRODUCT</p>
    <h1 class="display">Record two minutes. Get a week of content.</h1>
    <p class="hero__lede">
      Crucible turns one short talking-head video into an edited, captioned, on-brand video plus
      publishable posts for every platform you use. It exists because I kept seeing the same gap
      across clients — and honestly, in myself.
    </p>
    <div class="hero__actions">
      <a class="button-primary" href={CRUCIBLE_APP_URL}>Start free — first project on us</a>
      <a class="link-secondary" href="#why-i-built-it">Why I built it →</a>
    </div>
  </section>

  <!-- WHY I BUILT IT -->
  <section class="field field--ink" id="why-i-built-it" data-thread style="--thread-w: 3px;">
    <p class="label section-kicker"><span class="accent">WHY I BUILT IT</span></p>
    <h2 class="title section-title">The gap between having something to say and actually saying it</h2>
    <div class="prose-ink">
      <p>
        Clients would rattle off brilliant ideas when the cameras weren't rolling — sharp takes on
        their industry, hard-won lessons, the kind of insight that builds real authority. But as soon
        as I asked them to commit to a time and topic, they froze or delayed.
      </p>
      <p>
        I'm the same way. I avoid the camera. I overthink every post. And I know I'm not alone.
      </p>
      <p>
        The tools that exist — OpusClip, Hootsuite, and the rest — are built for people who already
        love being on camera. Influencers. Creators. People who don't flinch at the record button.
        For everyone else, those tools solve a problem they never reach.
      </p>
      <p>
        The alternative is hiring someone: a coach to hold you accountable, or a ghostwriter to do
        the actual work — interview you, prepare drafts, revise and execute. Either one runs
        $1,000–$5,000 a month. And there's still inertia: coordinating interview times, trading
        revisions back and forth, trying to get the tone right through a middleman. A coach won't
        prepare content. A ghostwriter won't edit video on top of the drafts.
      </p>
      <p class="prose-ink__point">
        So I built Crucible to bridge that gap — two ways in. When inspiration hits, open it and
        talk. When you're stuck staring at a blank screen, step into the Podcast Studio where an AI
        interviewer, armed with your brand profile, knowledge base, and research, asks the questions
        that unlock what you actually want to say. Either way, ten minutes gets you an edited video
        and a week of posts — in your voice, using your actual words.
      </p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="field field--paper" id="how-it-works" data-thread style="--thread-w: 5px;">
    <p class="label section-kicker"><span class="accent">PROCEDURE</span></p>
    <h2 class="title section-title">How it works</h2>
    <ol class="steps" role="list">
      {
        steps.map((s) => (
          <li class="steps__step">
            <p class="steps__n label">STEP {s.n}</p>
            <h3 class="steps__name">{s.name}</h3>
            <p class="steps__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- THE GAP IT FILLS -->
  <section class="field field--ink" data-thread style="--thread-w: 8px;">
    <p class="label section-kicker"><span class="accent">THE GAP IT FILLS</span></p>
    <h2 class="title section-title">Your actual face and voice, on your schedule</h2>
    <div class="diff__grid">
      <div class="diff__col">
        <h3 class="diff__name">You, not an interpreter</h3>
        <p class="diff__text">
          Ghostwriters strip out the nuances that make you credible. Crucible works from your
          exact words and your actual face on camera — no middleman filtering or sanitizing your
          takes.
        </p>
      </div>
      <div class="diff__col">
        <h3 class="diff__name">Two ways in</h3>
        <p class="diff__text">
          Got a take right now? Open Crucible and record. Blank screen? Step into the Podcast
          Studio — an AI interviewer studies your material, then asks the same kind of questions
          a ghostwriter or marketing hire would. It pulls the right content out of you without a
          scheduled call or a retainer.
        </p>
      </div>
      <div class="diff__col">
        <h3 class="diff__name">Video + text, not just text</h3>
        <p class="diff__text">
          Ghostwriters deliver posts. Coaches deliver accountability. Neither delivers an edited,
          captioned video with your face in it. Crucible does all three — because seeing a founder
          actually speak builds 10x more trust than another text post.
        </p>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="field field--ink" data-thread="hot" style="--thread-w: 12px;">
    <p class="label section-kicker"><span class="accent">PRICING</span></p>
    <h2 class="title section-title">Try it free</h2>
    <div class="pricing">
      <p class="pricing__price">$19<span class="pricing__per">/mo</span></p>
      <p class="pricing__terms label">FIRST PROJECT FREE — ALL FEATURES, NO WATERMARKS</p>
      <a class="button-primary" href={CRUCIBLE_APP_URL}>Start free</a>
    </div>
    <p class="pricing__closing">One full project at no cost. See if it fits before you commit.</p>
  </section>
</Base>

<style>
  .section-kicker {
    margin: 0 0 20px;
    color: var(--mist);
  }

  .field--paper .section-kicker {
    color: var(--ink-muted);
  }

  .section-title {
    margin: 0 0 var(--space-field);
    max-width: 22ch;
  }

  /* Hero */
  .hero__run {
    margin: 0 0 24px;
    color: var(--ink-muted);
  }

  .hero h1 {
    max-width: 12ch;
    margin-bottom: 28px;
  }

  .hero__lede {
    max-width: 58ch;
    font-size: 1.0625rem;
    margin: 0 0 var(--space-field);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-field);
    flex-wrap: wrap;
  }

  /* Problem */
  .prose-ink {
    max-width: 62ch;
  }

  .prose-ink p {
    margin: 0 0 20px;
    color: var(--paper-muted);
  }

  .prose-ink__point {
    color: var(--paper) !important;
    font-weight: 700;
  }

  /* How it works — generous vertical spacing */
  #how-it-works {
    scroll-margin-top: 64px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-light);
  }

  .steps__step {
    display: grid;
    grid-template-columns: 90px minmax(160px, 0.4fr) 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 40px 0;
    border-bottom: 1px solid var(--rule-light);
  }

  .steps__n {
    color: var(--reaction-orange-ink);
    margin: 0;
  }

  .steps__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    text-transform: uppercase;
    margin: 0;
  }

  .steps__text {
    margin: 0;
    max-width: 62ch;
  }

  /* Differentiators */
  .diff__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-field);
  }

  .diff__col {
    background: var(--ink-raised);
    border: 1px solid var(--rule-dark);
    border-radius: 2px;
    padding: var(--space-field);
  }

  .diff__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
    color: var(--paper);
  }

  .diff__text {
    margin: 0;
    color: var(--paper-muted);
    font-size: 0.9375rem;
  }

  /* Pricing */
  .pricing {
    background: var(--ink-raised);
    border: 1px solid var(--rule-dark);
    border-radius: 2px;
    padding: var(--space-field);
    max-width: 480px;
    margin-bottom: var(--space-field);
  }

  .pricing__price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 3rem;
    line-height: 1;
    margin: 0 0 8px;
  }

  .pricing__per {
    font-size: 1.5rem;
    color: var(--mist);
  }

  .pricing__terms {
    color: var(--reaction-orange);
    margin: 0 0 28px;
  }

  .pricing__closing {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    max-width: 24ch;
    margin: 0;
  }

  @media (max-width: 1000px) {
    .steps__step {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 32px 0;
    }
    .diff__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
