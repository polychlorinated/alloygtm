---
// DIRECTION CONTRACT — alloygtm.com home (Persuade)
// THESIS: Alloy GTM sells diagnosis fused with build — the offer is stated in
//   the first viewport and differentiated from consultants and tools by section
//   two. Refuses the category's vague "growth partner" hero.
// OWN-WORLD: The Reaction Log (DESIGN.md), unchanged. Alternating paper/ink
//   fields threaded by the gutter reaction path (2px→12px); Barlow Condensed
//   declarations, Manrope evidence, DM Mono run labels; orange = action,
//   blue = measurement; square records, ruled rows, authored SVG figures.
// STORY: A founder burned by half-solutions reads the hero, sees the
//   strategist/software gap named, recognizes their five leaks, picks one of
//   four ways in (Sprint recommended), checks outcomes, believes the proof
//   (Crucible runs in production), and books a Teardown.
// FIRST VIEWPORT: Ink nav (Alloy logo, Crucible · Services · About, Get a
//   Teardown CTA). Paper field: mono kicker DIAGNOSIS + BUILD, display "MOST
//   GTM ADVICE IS JUST HOMEWORK.", subhead, orange primary CTA + Crucible
//   secondary, muted trust line; right column FIG. 1 fusion diagram.
// FORM: Grounded candidate 7 (alternating fields threaded by the reaction
//   path), retained from the seed-committed structure (key 328d8fbc); only
//   content and IA change in this repositioning.

import Base from "../layouts/Base.astro";
import FusionFigure from "../components/FusionFigure.astro";
import { offers, offerOptions } from "../data/offers";

const leaks = [
  {
    n: "01",
    name: "Your CRM is a graveyard, not a system of record.",
    text: "Fields nobody fills in. Stages nobody agrees on. Reporting nobody trusts.",
  },
  {
    n: "02",
    name: "You're measuring activity, not signal.",
    text: "Emails sent. Posts published. Meetings booked. None of it tells you which behaviors actually predict revenue.",
  },
  {
    n: "03",
    name: "Your outbound sounds like everyone else's outbound.",
    text: "Same tools, same templates, same personalization tokens. Buyers pattern-match it into the trash in under a second.",
  },
  {
    n: "04",
    name: "Your discovery call isn't a process.",
    text: "Every rep runs it differently. Nothing is captured consistently. You can't improve what you can't compare.",
  },
  {
    n: "05",
    name: "Your content is built for search engines, not buyers.",
    text: "Ranking for terms your buyers don't use, while the questions they actually ask go unanswered.",
  },
];

const outcomes = [
  { stat: "2×", label: "Outbound reply rates, improved in a one-week sprint" },
  { stat: "10×", label: "B2B integration marketplace adoption growth in twelve months" },
  { stat: "+10", label: "NPS points at a computer science education platform" },
  { stat: "60%+", label: "YoY product revenue growth supported across a 20+ product portfolio" },
  { stat: "2 yrs+", label: "A solution discovery tool still running in production" },
];
---

<Base
  title="Alloy GTM — Diagnosis fused with build"
  description="Alloy GTM finds what's broken in your revenue system — then builds the fix. Not a deck. Not another tool. Working systems inside the stack you already have."
>
  <!-- 1 · HERO -->
  <section class="field field--paper hero" data-thread style="--thread-w: 2px;">
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="label hero__run"><span class="accent">DIAGNOSIS</span> + <span class="accent">BUILD</span></p>
        <h1 class="display">Most GTM advice is just homework.</h1>
        <p class="hero__lede">
          Alloy GTM finds what's broken in your revenue system — then builds the fix. Not a deck.
          Not another tool you have to implement yourself. Working systems inside the stack you
          already have.
        </p>
        <div class="hero__actions">
          <a class="button-primary" href="#teardown">Get a Teardown — $297</a>
          <a class="link-secondary" href="/crucible/">See Crucible →</a>
        </div>
        <p class="hero__trust">
          Revenue systems built across EdTech, enterprise automation, data, fintech, and AI.
        </p>
      </div>
      <div class="hero__figure">
        <FusionFigure />
      </div>
    </div>
  </section>

  <!-- 2 · THE GAP -->
  <section class="field field--ink" data-thread style="--thread-w: 3px;">
    <p class="label section-kicker"><span class="accent">THE GAP</span></p>
    <h2 class="title section-title">You've been sold half a solution.</h2>
    <div class="gap__grid">
      <div class="gap__col">
        <h3 class="gap__name">The strategist</h3>
        <p>Sharp diagnosis. A forty-page roadmap. Then they leave.</p>
        <p>You now have a document and the same team that was already at capacity.</p>
      </div>
      <div class="gap__col">
        <h3 class="gap__name">The software</h3>
        <p>Real capability. No context.</p>
        <p>You get a login, a documentation site, and a six-week implementation you didn't budget for.</p>
      </div>
    </div>
    <div class="gap__closing">
      <p class="gap__statement">Neither is wrong. Both are incomplete.</p>
      <p class="gap__alloy">
        An alloy is what happens when two elements fuse into something neither could be alone. Iron
        is soft. Carbon is brittle. Together they're steel.
      </p>
      <p class="gap__fused label"><span class="accent">ALLOY GTM</span> IS DIAGNOSIS FUSED WITH BUILD</p>
    </div>
  </section>

  <!-- 3 · WHAT'S USUALLY BROKEN -->
  <section class="field field--paper" data-thread style="--thread-w: 4px;">
    <p class="label section-kicker"><span class="accent">WHAT'S USUALLY BROKEN</span></p>
    <h2 class="title section-title">Five leaks, in almost every company</h2>
    <p class="section-lede-paper">Different industries. Same pathology.</p>
    <ol class="leaks" role="list">
      {
        leaks.map((l) => (
          <li class="leaks__row">
            <p class="label leaks__n">{l.n}</p>
            <h3 class="leaks__name">{l.name}</h3>
            <p class="leaks__text">{l.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="leaks__closing">Finding these is the easy part. Fixing them is the work.</p>
  </section>

  <!-- 4 · THE OFFER LADDER -->
  <section class="field field--ink" id="offer" data-thread="hot" style="--thread-w: 8px;">
    <p class="label section-kicker"><span class="accent">THE OFFER LADDER</span></p>
    <h2 class="title section-title">Four ways in</h2>
    <div class="offers">
      {
        offers.map((o) => (
          <article class:list={["offer", { "offer--recommended": o.recommended }]} id={o.id === "teardown" ? "teardown" : undefined}>
            {o.recommended && <p class="label offer__tag">RECOMMENDED</p>}
            <p class="label offer__terms">{o.terms}</p>
            <h3 class="offer__name">{o.name}</h3>
            <p class="offer__body">{o.body}</p>
            {o.note && <p class="offer__note">{o.note}</p>}
            <p class="offer__price label">{o.price}</p>
            <a class="link-secondary offer__cta" href={o.cta.href} data-offer={o.id !== "crucible" ? o.id : undefined}>
              → {o.cta.label}
            </a>
          </article>
        ))
      }
    </div>

    <!-- Enquiry form: Teardown / Sprint / Build CTAs land here -->
    <div class="enquire" id="enquire">
      <p class="label enquire__title"><span class="accent">ENQUIRY</span> — TEARDOWN · SPRINT · BUILD</p>
      <!-- TODO: replace the Formspree placeholder action with the production handler (open decision in PRODUCT.md) -->
      <form class="enquire__form" action="https://formspree.io/f/FORMSPREE_PLACEHOLDER" method="POST" data-enquire-form>
        <div class="enquire__row">
          <div class="field-group">
            <label class="label" for="first-name">First name</label>
            <input class="input" id="first-name" name="first-name" type="text" autocomplete="given-name" required />
          </div>
          <div class="field-group">
            <label class="label" for="last-name">Last name</label>
            <input class="input" id="last-name" name="last-name" type="text" autocomplete="family-name" required />
          </div>
        </div>
        <div class="field-group">
          <label class="label" for="email">Business email</label>
          <input class="input" id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field-group">
          <label class="label" for="offer-select">I'm interested in</label>
          <select class="input" id="offer-select" name="offer" data-offer-select>
            {offerOptions.map((opt) => <option value={opt.value}>{opt.label}</option>)}
          </select>
        </div>
        <div class="field-group">
          <label class="label" for="challenge">Current challenge</label>
          <textarea class="input" id="challenge" name="challenge" rows="5" required></textarea>
        </div>
        <button class="button-primary" type="submit">Send enquiry</button>
      </form>
    </div>
  </section>

  <!-- 5 · OUTCOMES -->
  <section class="field field--paper" data-thread style="--thread-w: 10px;">
    <p class="label section-kicker"><span class="accent">EVIDENCE</span></p>
    <h2 class="title section-title">Selected outcomes</h2>
    <ul class="outcomes" role="list">
      {
        outcomes.map((o) => (
          <li class="outcomes__cell">
            <p class="outcomes__stat">{o.stat}</p>
            <p class="outcomes__label">{o.label}</p>
          </li>
        ))
      }
    </ul>
    <p class="outcomes__foot">
      <a class="link-secondary" href="/about/">Context and detail on the about page →</a>
    </p>
  </section>

  <!-- 6 · CRUCIBLE SPOTLIGHT -->
  <section class="field field--ink" data-thread style="--thread-w: 10px;">
    <p class="label section-kicker"><span class="accent">PROOF OF BUILD</span></p>
    <h2 class="title section-title">Built, not recommended</h2>
    <div class="spotlight__body">
      <p>
        Crucible is an AI content engine for small businesses — brand voice modeling, automated
        video editing, and multi-platform content generation from a single short recording.
      </p>
      <p>
        It runs in production. It was designed, engineered, and shipped by the same person who would
        run your engagement.
      </p>
      <p class="spotlight__point">
        That's the point. Advice is easy to give. This is what the other half looks like.
      </p>
      <a class="button-primary" href="/crucible/">Explore Crucible →</a>
    </div>
  </section>

  <!-- 7 · FINAL CTA -->
  <section class="field field--paper cta" data-thread="hot" style="--thread-w: 12px;">
    <p class="label section-kicker"><span class="accent">NEXT ACTION</span></p>
    <h2 class="display cta__display">Start with a Teardown.</h2>
    <p class="cta__body">
      $297. Seventy-two hours. No call, no proposal, no discovery process. Send your setup, get an
      expert review and a prioritized list of what to fix first.
    </p>
    <div class="cta__actions">
      <a class="button-primary" href="#teardown">Get a Teardown — $297</a>
    </div>
  </section>
</Base>

<script>
  // Route offer-card CTAs into the enquiry form's offer selector.
  const select = document.querySelector<HTMLSelectElement>("[data-offer-select]");
  const param = new URLSearchParams(window.location.search).get("offer");
  if (select && param && select.querySelector(`option[value="${param}"]`)) {
    select.value = param;
  }
  document.querySelectorAll<HTMLAnchorElement>("a[data-offer]").forEach((a) => {
    a.addEventListener("click", () => {
      if (select) select.value = a.dataset.offer!;
    });
  });
</script>

<style>
  .section-kicker {
    margin: 0 0 20px;
    color: var(--mist);
  }

  .field--paper .section-kicker {
    color: var(--ink-muted);
  }

  .section-title {
    margin: 0 0 var(--space-field);
    max-width: 22ch;
  }

  .section-lede-paper {
    max-width: 56ch;
    color: var(--ink-subtle);
    margin: -16px 0 var(--space-field);
  }

  /* Hero */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .hero__run {
    margin: 0 0 24px;
    color: var(--ink-muted);
  }

  .hero h1 {
    max-width: 10ch;
    margin-bottom: 28px;
  }

  .hero__lede {
    max-width: 58ch;
    font-size: 1.0625rem;
    margin: 0 0 var(--space-field);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-field);
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .hero__trust {
    font-size: 0.875rem;
    color: var(--ink-muted);
    margin: 0;
    max-width: 58ch;
  }

  @media (min-width: 1000px) {
    .hero__trust {
      white-space: nowrap;
      max-width: none;
    }
  }

  /* The Gap */
  .gap__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-field);
    margin-bottom: var(--space-section);
  }

  .gap__col {
    background: var(--ink-raised);
    border: 1px solid var(--rule-dark);
    border-radius: 2px;
    padding: var(--space-field);
  }

  .gap__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
    color: var(--paper);
  }

  .gap__col p {
    color: var(--paper-muted);
    margin: 0 0 12px;
    max-width: 46ch;
  }

  .gap__col p:last-child {
    margin-bottom: 0;
  }

  .gap__closing {
    border-top: 1px solid var(--rule-dark);
    padding-top: var(--space-field);
  }

  .gap__statement {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
    max-width: 18ch;
    margin: 0 0 24px;
  }

  .gap__alloy {
    max-width: 62ch;
    color: var(--paper-muted);
    margin: 0 0 24px;
  }

  .gap__fused {
    color: var(--paper);
    margin: 0;
  }

  /* Leaks */
  .leaks {
    list-style: none;
    margin: 0 0 var(--space-field);
    padding: 0;
    border-top: 1px solid var(--rule-light);
  }

  .leaks__row {
    display: grid;
    grid-template-columns: 70px minmax(220px, 0.8fr) 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule-light);
  }

  .leaks__n {
    color: var(--reagent-blue);
    margin: 0;
  }

  .leaks__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .leaks__text {
    margin: 0;
    color: var(--ink-subtle);
    max-width: 56ch;
  }

  .leaks__closing {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 24ch;
  }

  /* Offer ladder */
  #offer {
    scroll-margin-top: 64px;
  }

  .offers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: var(--space-section);
  }

  .offer {
    position: relative;
    background: var(--paper-bright);
    color: var(--ink);
    border: 1px solid var(--rule-dark);
    border-radius: 2px;
    padding: 24px;
    box-shadow: 8px 10px 0 rgba(7, 27, 36, 0.5);
    display: flex;
    flex-direction: column;
    scroll-margin-top: 80px;
  }

  .offer--recommended {
    box-shadow: 12px 14px 0 rgba(240, 100, 50, 0.25);
    border-color: var(--reaction-orange);
  }

  .offer__tag {
    position: absolute;
    top: -1px;
    right: -1px;
    background: var(--reaction-orange);
    color: var(--ink);
    padding: 6px 12px;
    margin: 0;
  }

  .offer__terms {
    color: var(--ink-muted);
    margin: 0 0 16px;
  }

  .offer__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
  }

  .offer__body {
    margin: 0 0 16px;
    font-size: 0.9375rem;
    flex: 1;
  }

  .offer__note {
    margin: 0 0 16px;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .offer__price {
    color: var(--reaction-orange-ink);
    margin: 0 0 20px;
  }

  .offer__cta {
    margin-top: auto;
  }

  /* Enquiry form */
  .enquire {
    background: var(--paper-bright);
    color: var(--ink);
    border: 1px solid var(--rule-dark);
    border-radius: 2px;
    padding: var(--space-field);
    box-shadow: 12px 14px 0 rgba(7, 27, 36, 0.5);
    max-width: 720px;
    scroll-margin-top: 80px;
  }

  .enquire__title {
    margin: 0 0 28px;
    color: var(--ink-muted);
  }

  .enquire__title .accent {
    color: var(--reaction-orange-ink);
  }

  .enquire__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .enquire__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-group .label {
    color: var(--ink-subtle);
  }

  /* Outcomes */
  .outcomes {
    list-style: none;
    margin: 0 0 var(--space-field);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--rule-light);
    border-left: 1px solid var(--rule-light);
  }

  .outcomes__cell {
    border-right: 1px solid var(--rule-light);
    border-bottom: 1px solid var(--rule-light);
    padding: 24px;
  }

  .outcomes__stat {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }

  .outcomes__label {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-subtle);
  }

  .outcomes__foot {
    margin: 0;
  }

  /* Crucible spotlight */
  .spotlight__body {
    max-width: 62ch;
  }

  .spotlight__body p {
    margin: 0 0 20px;
    color: var(--paper-muted);
  }

  .spotlight__point {
    color: var(--paper) !important;
    font-weight: 700;
  }

  .spotlight__body .button-primary {
    margin-top: 12px;
  }

  /* Final CTA */
  .cta__display {
    max-width: 12ch;
    margin-bottom: 24px;
  }

  .cta__body {
    max-width: 52ch;
    font-size: 1.0625rem;
    margin: 0 0 var(--space-field);
  }

  .cta__actions {
    display: flex;
    align-items: center;
    gap: var(--space-field);
    flex-wrap: wrap;
  }

  @media (max-width: 1100px) {
    .offers {
      grid-template-columns: repeat(2, 1fr);
    }
    .outcomes {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 1000px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero h1 {
      max-width: 12ch;
    }
    .leaks__row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .gap__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .offers {
      grid-template-columns: 1fr;
    }
    .outcomes {
      grid-template-columns: 1fr;
    }
    .enquire__row {
      grid-template-columns: 1fr;
    }
  }
</style>
