---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: "crucible" | "about";
}

const { title, description, active } = Astro.props;
const logoSrc = "/alloy-basic-white-logo.webp";
const logoAlt = "Alloy GTM home";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Google Tag Manager -->
    <script>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-WC23TWS2");
    </script>
    <!-- End Google Tag Manager -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;700;800;900&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WC23TWS2"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe
    ></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="nav">
      <a class="nav__wordmark" href="/">
        <img src={logoSrc} alt={logoAlt} width="674" height="179" />
      </a>

      <nav class="nav__links" aria-label="Primary">
        <a href="/crucible/" aria-current={active === "crucible" ? "page" : undefined}>Crucible</a>
        <a href="/#offer">Services</a>
        <a href="/about/" aria-current={active === "about" ? "page" : undefined}>About</a>
      </nav>

      <a class="button-primary nav__cta" href="/#enquire">Start an Enquiry</a>

      <button class="nav__toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </header>

    <div class="nav__menu" id="nav-menu" hidden>
      <a class="nav__menu-wordmark" href="/">
        <img src={logoSrc} alt={logoAlt} width="674" height="179" />
      </a>
      <a href="/crucible/" aria-current={active === "crucible" ? "page" : undefined}>Crucible</a>
      <a href="/#offer">Services</a>
      <a href="/about/" aria-current={active === "about" ? "page" : undefined}>About</a>
      <a class="button-primary" href="/#enquire">Start an Enquiry</a>
    </div>

    <main id="content">
      <div class="reaction-line"></div>
      <div class="reaction-dot" id="reaction-dot"></div>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <div class="footer__brand">
          <a class="footer__wordmark" href="/">
            <img src={logoSrc} alt={logoAlt} width="674" height="179" />
          </a>
          <p class="footer__line label">
            Diagnosis fused with build<br />
            Powered by <a href="https://polychlorinated.com">Polychlorinated Ventures LLC</a>
          </p>
        </div>
        <nav class="footer__nav label" aria-label="Footer">
          <a href="/crucible/">Crucible</a>
          <a href="/#offer">Services</a>
          <a href="/about/">About</a>
        </nav>
        <p class="footer__copy label">© 2025–2026</p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector(".nav__toggle");
      const menu = document.querySelector(".nav__menu");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
        if (menu) menu.hidden = open;
      });

      const dot = document.getElementById("reaction-dot");
      const main = document.querySelector("main");
      const navH = 64;

      function updateDot() {
        if (window.innerWidth < 1100) return;
        const mainRect = main.getBoundingClientRect();
        const viewH = window.innerHeight;
        const total = mainRect.height - viewH;
        const scrolled = -mainRect.top;
        const progress = Math.min(Math.max(scrolled / total, 0), 1);
        const range = viewH - navH - 32;
        dot.style.top = navH + range * progress + "px";
      }

      window.addEventListener("scroll", updateDot, { passive: true });
      window.addEventListener("resize", updateDot, { passive: true });
      updateDot();
    </script>
  </body>
</html>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: var(--space-field);
    height: 64px;
    padding: 0 var(--gutter);
    background: var(--ink);
    border-bottom: 1px solid var(--rule-dark);
    color: var(--paper);
  }

  .nav__wordmark {
    display: flex;
    align-items: center;
    margin-right: auto;
    text-decoration: none;
    line-height: 0;
  }

  .nav__wordmark img,
  .nav__menu-wordmark img,
  .footer__wordmark img {
    display: block;
    width: auto;
  }

  .nav__wordmark img {
    height: 26px;
  }

  .nav__links {
    display: flex;
    gap: var(--space-field);
  }

  .nav__links a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--mist);
    padding: 8px 0;
    transition: color 160ms ease;
  }

  .nav__links a:hover {
    color: var(--paper);
  }

  .nav__links a[aria-current="page"] {
    color: var(--reaction-orange);
  }

  .nav__cta {
    min-height: 44px;
    padding: 10px 18px;
  }

  .nav__toggle {
    display: none;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--rule-dark);
    border-radius: 0;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .nav__toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--paper);
  }

  .nav__menu {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    z-index: 49;
    background: var(--ink);
    border-bottom: 1px solid var(--rule-dark);
    padding: var(--space-field) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .nav__menu[hidden] {
    display: none;
  }

  .nav__menu a:not(.button-primary) {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
  }

  .nav__menu-wordmark {
    display: block;
    width: fit-content;
    line-height: 0;
  }

  .nav__menu-wordmark img {
    height: 28px;
  }

  .nav__menu a[aria-current="page"] {
    color: var(--reaction-orange);
  }

  main {
    padding-top: 64px;
  }

  @media (max-width: 900px) {
    .nav__links,
    .nav__cta {
      display: none;
    }
    .nav__toggle {
      display: flex;
    }
  }

  @media (min-width: 901px) {
    .nav__menu {
      display: none;
    }
  }

  .footer {
    background: var(--ink);
    color: var(--paper);
    border-top: 1px solid var(--rule-dark);
    padding: var(--space-field) var(--gutter);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-field);
  }

  .footer__brand {
    margin-right: auto;
  }

  .footer__wordmark {
    display: inline-block;
    line-height: 0;
  }

  .footer__wordmark img {
    height: 24px;
  }

  .footer__line {
    color: var(--mist);
    margin: 12px 0 0;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .footer__line a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .footer__line a:hover {
    color: var(--reaction-orange);
  }

  .footer__nav {
    display: flex;
    gap: 24px;
  }

  .footer__nav a {
    color: var(--mist);
    text-decoration: none;
  }

  .footer__nav a:hover {
    color: var(--reaction-orange);
  }

  .footer__copy {
    color: var(--mist);
    margin: 0;
  }
</style>
