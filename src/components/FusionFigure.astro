---
interface Props {
  id?: string;
  title?: string;
  caption?: string;
}

const {
  id = "FIG. 1",
  title = "SCHEMATIC — GTM DEBT RECOVERY VIA TECHNICAL SYNTHESIS",
  caption = "Integrating GTM architecture with custom tooling to eliminate friction across your revenue stack.",
} = Astro.props;
---

<figure class="fig" data-fusion-figure>
  <figcaption class="fig__title label">
    <span class="fig__id">{id}</span>
    <span>{title}</span>
  </figcaption>

  <svg
    class="fig__svg"
    viewBox="0 0 800 460"
    role="img"
    aria-label="Forge schematic: two metals — Alloy (Tools + Experience) and Client (Data + Team + Market) — melt via Diagnose and Build into a crucible, producing Scalable GTM System"
    data-phase="0"
  >
    <defs>
      <pattern id="metal-hatch" width="8" height="8" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
        <rect width="8" height="8" fill="transparent"/>
        <line x1="0" y1="0" x2="0" y2="8" stroke="#071b24" stroke-width="1.5" opacity="0.25"/>
      </pattern>
      <pattern id="metal-hatch-orange" width="8" height="8" patternTransform="rotate(-30)" patternUnits="userSpaceOnUse">
        <rect width="8" height="8" fill="transparent"/>
        <line x1="0" y1="0" x2="0" y2="8" stroke="#f06432" stroke-width="2" opacity="0.3"/>
      </pattern>
      <pattern id="alloy-hatch" width="6" height="6" patternTransform="rotate(60)" patternUnits="userSpaceOnUse">
        <rect width="6" height="6" fill="transparent"/>
        <line x1="0" y1="0" x2="0" y2="6" stroke="#155eef" stroke-width="1.5" opacity="0.35"/>
      </pattern>
      <filter id="fire-glow">
        <feGaussianBlur stdDeviation="4" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <!-- background -->
    <rect x="20" y="20" width="760" height="420" fill="#fffdf7" stroke="#c7d0d0" stroke-width="1" rx="2"/>

    <!-- ====== CRUCIBLE / FORGE VESSEL ====== -->
    <g class="crucible">
      <!-- bowl shape -->
      <path d="M310,240 L490,240 L460,340 L340,340 Z" fill="#f2f2ec" stroke="#071b24" stroke-width="2.5" stroke-linejoin="round"/>
      <!-- rim -->
      <rect x="300" y="232" width="200" height="16" rx="3" fill="#cfdbdb" stroke="#071b24" stroke-width="2"/>
      <!-- interior molten area (hidden initially) -->
      <g class="crucible__melt" opacity="0">
        <ellipse cx="400" cy="290" rx="60" ry="20" fill="#f06432" opacity="0.6"/>
        <ellipse cx="400" cy="290" rx="45" ry="14" fill="#ff8a5c" opacity="0.5"/>
      </g>
    </g>

    <!-- ====== FIRE / FLAMES ====== -->
    <g class="fire" opacity="0">
      <!-- Diagnose flame (left) -->
      <g filter="url(#fire-glow)">
        <path d="M360,340 Q370,360 365,390 Q360,410 355,390 Q350,360 360,340" fill="#f06432" opacity="0.8">
          <animate attributeName="d" dur="1.2s" repeatCount="indefinite" values="
            M360,340 Q370,360 365,390 Q360,410 355,390 Q350,360 360,340;
            M360,340 Q375,355 367,388 Q360,415 352,388 Q345,355 360,340;
            M360,340 Q370,360 365,390 Q360,410 355,390 Q350,360 360,340
          "/>
        </path>
      </g>
      <text x="362" y="420" text-anchor="middle" font-family="DM Mono, monospace" font-size="9" letter-spacing="0.08em" fill="#b5431a">DIAGNOSE</text>

      <!-- Build flame (right) -->
      <g filter="url(#fire-glow)">
        <path d="M440,340 Q450,360 445,390 Q440,410 435,390 Q430,360 440,340" fill="#155eef" opacity="0.8">
          <animate attributeName="d" dur="1.4s" repeatCount="indefinite" values="
            M440,340 Q450,360 445,390 Q440,410 435,390 Q430,360 440,340;
            M440,340 Q455,355 447,388 Q440,415 432,388 Q425,355 440,340;
            M440,340 Q450,360 445,390 Q440,410 435,390 Q430,360 440,340
          "/>
        </path>
      </g>
      <text x="440" y="420" text-anchor="middle" font-family="DM Mono, monospace" font-size="9" letter-spacing="0.08em" fill="#155eef">BUILD</text>
    </g>

    <!-- ====== ALLOY METAL (Tools + Experience) — left ====== -->
    <g class="metal metal--alloy">
      <rect x="60" y="160" width="130" height="110" rx="3" fill="url(#metal-hatch-orange)" stroke="#f06432" stroke-width="2.5"/>
      <rect x="60" y="160" width="130" height="110" rx="3" fill="none" stroke="#071b24" stroke-width="1" opacity="0.3"/>
      <line x1="60" y1="180" x2="190" y2="180" stroke="#071b24" stroke-width="0.5" opacity="0.15"/>
      <line x1="60" y1="230" x2="190" y2="230" stroke="#071b24" stroke-width="0.5" opacity="0.15"/>
      <text x="125" y="200" text-anchor="middle" font-family="DM Mono, monospace" font-size="12" font-weight="500" letter-spacing="0.08em" fill="#071b24">ALLOY</text>
      <text x="125" y="222" text-anchor="middle" font-family="DM Mono, monospace" font-size="9" letter-spacing="0.06em" fill="#68797f">TOOLS</text>
      <text x="125" y="240" text-anchor="middle" font-family="DM Mono, monospace" font-size="9" letter-spacing="0.06em" fill="#68797f">EXPERIENCE</text>
      <text x="125" y="262" text-anchor="middle" font-family="DM Mono, monospace" font-size="8" fill="#8ca0a7" letter-spacing="0.06em">ELEMENT A</text>
    </g>

    <!-- ====== CLIENT METAL (Data + Team + Market) — right ====== -->
    <g class="metal metal--client">
      <rect x="610" y="160" width="130" height="110" rx="3" fill="url(#metal-hatch)" stroke="#5a6c74" stroke-width="2.5"/>
      <rect x="610" y="160" width="130" height="110" rx="3" fill="none" stroke="#071b24" stroke-width="1" opacity="0.3"/>
      <line x1="610" y1="180" x2="740" y2="180" stroke="#071b24" stroke-width="0.5" opacity="0.15"/>
      <line x1="610" y1="230" x2="740" y2="230" stroke="#071b24" stroke-width="0.5" opacity="0.15"/>
      <text x="675" y="200" text-anchor="middle" font-family="DM Mono, monospace" font-size="12" font-weight="500" letter-spacing="0.08em" fill="#071b24">CLIENT</text>
      <text x="675" y="220" text-anchor="middle" font-family="DM Mono, monospace" font-size="9" letter-spacing="0.06em" fill="#68797f">DATA</text>
      <text x="675" y="236" text-anchor="middle" font-family="DM Mono, monospace" font-size="9" letter-spacing="0.06em" fill="#68797f">TEAM</text>
      <text x="675" y="252" text-anchor="middle" font-family="DM Mono, monospace" font-size="9" letter-spacing="0.06em" fill="#68797f">MARKET</text>
      <text x="675" y="268" text-anchor="middle" font-family="DM Mono, monospace" font-size="8" fill="#8ca0a7" letter-spacing="0.06em">ELEMENT B</text>
    </g>

    <!-- ====== MOLTEN DRIPS (hidden initially) ====== -->
    <g class="drips" opacity="0">
      <!-- alloy drips -->
      <circle cx="180" cy="280" r="4" fill="#f06432" opacity="0.7"/>
      <circle cx="220" cy="300" r="5" fill="#f06432" opacity="0.8"/>
      <circle cx="200" cy="260" r="3" fill="#f06432" opacity="0.5"/>
      <!-- client drips -->
      <circle cx="620" cy="280" r="4" fill="#5a6c74" opacity="0.7"/>
      <circle cx="580" cy="300" r="5" fill="#5a6c74" opacity="0.8"/>
      <circle cx="600" cy="260" r="3" fill="#5a6c74" opacity="0.5"/>
    </g>

    <!-- ====== FLOW ARROWS FROM METALS TO CRUCIBLE ====== -->
    <g class="flow-arrows" opacity="0">
      <!-- alloy → crucible -->
      <path d="M190,215 L250,240" fill="none" stroke="#f06432" stroke-width="2" stroke-dasharray="4 3"/>
      <polygon points="255,238 248,244 252,236" fill="#f06432"/>
      <!-- client → crucible -->
      <path d="M610,215 L550,240" fill="none" stroke="#5a6c74" stroke-width="2" stroke-dasharray="4 3"/>
      <polygon points="545,238 548,236 552,244" fill="#5a6c74"/>
    </g>

    <!-- ====== ALLOY OUTPUT (hidden initially) ====== -->
    <g class="alloy-output" opacity="0">
      <!-- spout stream -->
      <path d="M400,340 L400,370" stroke="#155eef" stroke-width="3" opacity="0.7"/>
      <!-- output block -->
      <rect x="310" y="374" width="180" height="50" rx="3" fill="url(#alloy-hatch)" stroke="#155eef" stroke-width="2.5"/>
      <rect x="310" y="374" width="180" height="50" rx="3" fill="none" stroke="#071b24" stroke-width="1" opacity="0.3"/>
      <text x="400" y="394" text-anchor="middle" font-family="DM Mono, monospace" font-size="10" font-weight="500" letter-spacing="0.06em" fill="#071b24">SCALABLE GTM</text>
      <text x="400" y="412" text-anchor="middle" font-family="DM Mono, monospace" font-size="10" font-weight="500" letter-spacing="0.06em" fill="#071b24">SYSTEM</text>
      <text x="400" y="444" text-anchor="middle" font-family="DM Mono, monospace" font-size="8" fill="#155eef" letter-spacing="0.06em">THE ALLOY</text>
    </g>

    <!-- ====== PHASE LABEL (bottom) ====== -->
    <text x="400" y="16" text-anchor="middle" font-family="DM Mono, monospace" font-size="10" letter-spacing="0.12em" fill="#8ca0a7" class="phase-label">ELEMENTS A + B — SOLID</text>
  </svg>

  <p class="fig__caption">{caption}</p>
</figure>

<style>
  .fig {
    margin: 0;
    background: var(--paper-bright);
    border: 1px solid var(--rule-light);
    border-radius: 2px;
    padding: 16px;
    box-shadow: 10px 12px 0 rgba(7, 27, 36, 0.14);
  }

  .fig__title {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--rule-light);
    color: var(--ink);
  }

  .fig__id {
    color: var(--reaction-orange-ink);
    white-space: nowrap;
  }

  .fig__svg {
    display: block;
    width: 100%;
    height: auto;
    cursor: pointer;
  }

  .fig__caption {
    margin: 12px 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-subtle);
    max-width: 52ch;
  }

  /* Phase transitions */
  .fire,
  .drips,
  .flow-arrows,
  .crucible__melt,
  .alloy-output {
    transition: opacity 800ms ease;
  }

  [data-phase="1"] .fire {
    opacity: 1;
  }

  [data-phase="1"] .metal--alloy {
    opacity: 0.5;
    transition: opacity 1200ms ease;
  }

  [data-phase="1"] .drips {
    opacity: 1;
  }

  [data-phase="2"] .fire {
    opacity: 1;
  }

  [data-phase="2"] .metal--alloy {
    opacity: 0.2;
  }

  [data-phase="2"] .metal--client {
    opacity: 0.5;
    transition: opacity 1200ms ease;
  }

  [data-phase="2"] .drips {
    opacity: 1;
  }

  [data-phase="2"] .flow-arrows {
    opacity: 1;
  }

  [data-phase="3"] .fire {
    opacity: 1;
  }

  [data-phase="3"] .metal--alloy,
  [data-phase="3"] .metal--client {
    opacity: 0.1;
  }

  [data-phase="3"] .drips {
    opacity: 0;
    transition: opacity 500ms ease;
  }

  [data-phase="3"] .flow-arrows {
    opacity: 1;
  }

  [data-phase="3"] .crucible__melt {
    opacity: 1;
    transition: opacity 1000ms ease 400ms;
  }

  [data-phase="3"] .alloy-output {
    opacity: 1;
    transition: opacity 1000ms ease 800ms;
  }
</style>

<script>
  const figure = document.querySelector("[data-fusion-figure]") as HTMLElement;
  const svg = figure?.querySelector(".fig__svg") as SVGElement;
  const label = svg?.querySelector(".phase-label") as SVGTextElement;

  if (svg && label) {
    const phases = [
      { phase: "0", label: "ELEMENTS A + B — SOLID" },
      { phase: "1", label: "PHASE 1 — ALLOY MELTING (DIAGNOSE + BUILD)" },
      { phase: "2", label: "PHASE 2 — CLIENT MELTING" },
      { phase: "3", label: "PHASE 3 — ALLOY FORMED: SCALABLE GTM SYSTEM" },
    ];
    let idx = 0;

    svg.addEventListener("click", () => {
      idx = (idx + 1) % phases.length;
      svg.setAttribute("data-phase", phases[idx].phase);
      label.textContent = phases[idx].label;
    });
  }
</script>
