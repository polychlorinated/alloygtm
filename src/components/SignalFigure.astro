---
interface Props {
  id?: string;
  title?: string;
  caption?: string;
}

const {
  id = "FIG. 1",
  title = "SIGNAL RESONANCE — BRAND BROADCAST VS. MARKET FRICTION",
  caption = "The gap between the signal you send and the pain the market broadcasts is where growth leaks.",
} = Astro.props;
---

<figure class="figure">
  <figcaption class="figure__title label">
    <span class="figure__id">{id}</span>
    <span>{title}</span>
  </figcaption>

  <svg viewBox="0 0 560 400" role="img" aria-label="Instrument plot comparing a company's brand broadcast signal against market friction, with an unclaimed signal gap highlighted between them">
    <defs>
      <pattern id="gap-hatch" width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
        <rect width="7" height="7" fill="transparent"></rect>
        <line x1="0" y1="0" x2="0" y2="7" stroke="#f06432" stroke-width="2"></line>
      </pattern>
    </defs>

    <!-- plot frame & grid -->
    <rect x="48" y="72" width="488" height="280" fill="#fffdf7" stroke="#c7d0d0" stroke-width="1"></rect>
    <g stroke="#e2e4da" stroke-width="1">
      <line x1="48" y1="128" x2="536" y2="128"></line>
      <line x1="48" y1="184" x2="536" y2="184"></line>
      <line x1="48" y1="240" x2="536" y2="240"></line>
      <line x1="48" y1="296" x2="536" y2="296"></line>
    </g>
    <g stroke="#e2e4da" stroke-width="1">
      <line x1="170" y1="72" x2="170" y2="352"></line>
      <line x1="292" y1="72" x2="292" y2="352"></line>
      <line x1="414" y1="72" x2="414" y2="352"></line>
    </g>

    <!-- unclaimed-signal gap between the two traces -->
    <path
      d="M400,226 L440,238 L480,198 L536,176 L536,156 C512,162 480,182 452,190 C430,196 412,186 400,182 Z"
      fill="url(#gap-hatch)"
      opacity="0.85"></path>

    <!-- market friction (measured noise) -->
    <path
      d="M48,318 L90,306 L122,316 L160,282 L200,298 L240,266 L280,282 L320,246 L360,260 L400,226 L440,238 L480,198 L536,176"
      fill="none"
      stroke="#8ca0a7"
      stroke-width="2.5"
      stroke-linejoin="round"></path>

    <!-- brand broadcast (measured signal) -->
    <path
      d="M48,300 C100,282 122,238 170,250 C218,262 252,204 300,220 C348,236 372,172 400,182 C430,196 480,170 536,156"
      fill="none"
      stroke="#155eef"
      stroke-width="3.5"
      stroke-linecap="round"></path>

    <!-- acquisition nodes -->
    <circle cx="170" cy="250" r="5" fill="#155eef"></circle>
    <circle cx="400" cy="182" r="5" fill="#155eef"></circle>
    <circle cx="480" cy="198" r="5" fill="#071b24" stroke="#8ca0a7" stroke-width="2"></circle>

    <!-- gap marker -->
    <line x1="468" y1="216" x2="468" y2="120" stroke="#f06432" stroke-width="1.5" stroke-dasharray="4 4"></line>
    <text x="460" y="112" text-anchor="end" font-family="DM Mono, monospace" font-size="11" letter-spacing="1" fill="#b5431a">UNCLAIMED SIGNAL</text>

    <!-- series labels -->
    <text x="60" y="290" font-family="DM Mono, monospace" font-size="11" letter-spacing="1" fill="#155eef">BRAND BROADCAST</text>
    <text x="60" y="340" font-family="DM Mono, monospace" font-size="11" letter-spacing="1" fill="#68797f">MARKET FRICTION</text>

    <!-- axes -->
    <text x="48" y="382" font-family="DM Mono, monospace" font-size="10" letter-spacing="1.5" fill="#68797f">DISCOVERY</text>
    <text x="236" y="382" font-family="DM Mono, monospace" font-size="10" letter-spacing="1.5" fill="#68797f">ACQUISITION</text>
    <text x="446" y="382" font-family="DM Mono, monospace" font-size="10" letter-spacing="1.5" fill="#68797f">RETENTION</text>
    <text x="20" y="76" font-family="DM Mono, monospace" font-size="10" letter-spacing="1.5" fill="#68797f" transform="rotate(-90 20 76)">SIGNAL INTENSITY</text>
  </svg>

  <p class="figure__caption">{caption}</p>
</figure>

<style>
  .figure {
    margin: 0;
    background: var(--paper-bright);
    border: 1px solid var(--rule-light);
    border-radius: 2px;
    padding: 16px;
    box-shadow: 10px 12px 0 rgba(7, 27, 36, 0.14);
  }

  .figure__title {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--rule-light);
    color: var(--ink);
  }

  .figure__id {
    color: var(--reaction-orange-ink);
    white-space: nowrap;
  }

  .figure__caption {
    margin: 12px 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-subtle);
    max-width: 52ch;
  }
</style>
