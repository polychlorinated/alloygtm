---
import { engagements } from "../data/engagements";
---

<div class="ownership" data-ownership>
  <!-- The route: nodes on a continuous path whose segments gain weight with ownership -->
  <div class="ownership__route" role="tablist" aria-label="Engagement ownership levels">
    <div class="ownership__track" aria-hidden="true">
      <span class="ownership__seg ownership__seg--a"></span>
      <span class="ownership__seg ownership__seg--b"></span>
    </div>
    {
      engagements.map((e, i) => (
        <button
          class="ownership__node"
          role="tab"
          id={`tab-${e.id}`}
          aria-controls={`panel-${e.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-tab={e.id}
        >
          <span class="ownership__dot" aria-hidden="true" />
          <span class="ownership__level label">{e.level}</span>
        </button>
      ))
    }
  </div>

  <div class="ownership__panels">
    {
      engagements.map((e, i) => (
        <div
          class="ownership__panel"
          role="tabpanel"
          id={`panel-${e.id}`}
          aria-labelledby={`tab-${e.id}`}
          hidden={i !== 0}
          data-panel={e.id}
        >
          <p class="ownership__meta label">
            <span class="ownership__index">LEVEL {String(i + 1)}/3</span>
            {e.name}
          </p>
          <h3 class="ownership__name title">{e.level}</h3>
          <p class="ownership__summary">{e.summary}</p>
          <p class="ownership__deliverable label">
            <span aria-hidden="true">▸</span> Deliverable — {e.deliverable}
          </p>
          <a class="link-secondary" href={e.cta.href}>{e.cta.label} →</a>
        </div>
      ))
    }
  </div>
</div>

<script>
  const root = document.querySelector("[data-ownership]");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));

    function select(id: string, focus = false) {
      tabs.forEach((t) => {
        const active = t.dataset.tab === id;
        t.setAttribute("aria-selected", String(active));
        t.tabIndex = active ? 0 : -1;
        if (active && focus) t.focus();
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== id;
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab.dataset.tab!));
      tab.addEventListener("keydown", (ev) => {
        let next: number | null = null;
        if (ev.key === "ArrowRight") next = (i + 1) % tabs.length;
        if (ev.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
        if (ev.key === "Home") next = 0;
        if (ev.key === "End") next = tabs.length - 1;
        if (next !== null) {
          ev.preventDefault();
          select(tabs[next].dataset.tab!, true);
        }
      });
    });
  }
</script>

<style>
  .ownership__route {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 28px 0;
    margin-bottom: var(--space-field);
  }

  /* track segments: weight increases with ownership */
  .ownership__track {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ownership__seg {
    position: absolute;
    top: 40px;
    background: var(--rule-dark);
  }

  .ownership__seg--a {
    left: 16.66%;
    right: 50%;
    height: 4px;
    translate: 0 -50%;
  }

  .ownership__seg--b {
    left: 50%;
    right: 16.66%;
    height: 9px;
    translate: 0 -50%;
  }

  .ownership__node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: var(--mist);
    font: inherit;
  }

  .ownership__dot {
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    background: var(--ink);
    border: 2px solid var(--rule-dark);
    transition: background-color 160ms ease, border-color 160ms ease, scale 160ms ease;
  }

  .ownership__node:hover .ownership__dot {
    border-color: var(--paper);
  }

  .ownership__node[aria-selected="true"] {
    color: var(--paper);
  }

  .ownership__node[aria-selected="true"] .ownership__dot {
    background: var(--reaction-orange);
    border-color: var(--reaction-orange);
    scale: 1.15;
  }

  .ownership__level {
    letter-spacing: 0.14em;
  }

  .ownership__panels {
    border-top: 1px solid var(--rule-dark);
  }

  .ownership__panel {
    padding-top: var(--space-field);
    max-width: 720px;
  }

  .ownership__meta {
    color: var(--mist);
    margin: 0 0 16px;
    display: flex;
    gap: 16px;
    align-items: baseline;
  }

  .ownership__index {
    color: var(--reagent-blue-bright);
  }

  .ownership__name {
    margin-bottom: 20px;
  }

  .ownership__summary {
    max-width: 62ch;
    color: var(--paper-muted);
    margin: 0 0 24px;
  }

  .ownership__deliverable {
    color: var(--reaction-orange);
    margin: 0 0 28px;
  }

  .ownership__deliverable span {
    color: var(--reaction-orange);
  }

  @media (max-width: 700px) {
    .ownership__route {
      padding: 20px 0;
    }
    .ownership__seg {
      top: 32px;
    }
    .ownership__dot {
      width: 18px;
      height: 18px;
    }
  }
</style>
